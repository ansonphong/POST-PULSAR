# POST PULSAR non-secret settings. Copy to post-pulsar.toml.
# Paths are relative to this file. Replace numeric example IDs before publishing.

[app]
state_directory = ".post-pulsar"
log_file = ".post-pulsar/logs/post_pulsar.log"
log_max_bytes = 5242880
log_backups = 3
deployment_mode = "simple"
# Hardened mode requires dedicated OS accounts and a shared discovery directory
# OUTSIDE state_directory. Provision traversable, non-writable ancestors first.
# Linux POSIX: numeric core/agent UIDs plus a dedicated GID whose only members are the
# agent and optionally core. The agent must have no additional groups. Core must
# be able to chown new records to that GID. Discovery is exactly 0750/0640, with
# no extended ACLs; existing mismatches fail closed rather than being repaired.
# hardened_core_principal = "1001"
# hardened_agent_principal = "1002"
# hardened_agent_group = 1003
# Windows: omit hardened_agent_group and use distinct, resolvable user SIDs
# (S-1-5-21-...-1001 / S-1-5-21-...-1002). Use unprivileged agent accounts and
# provision protected core/agent ACLs on ancestors below the trusted volume root.
# Other POSIX platforms fail closed until native extended-ACL checks are available.
# Unsupported native ACL/identity checks fail closed. OS administrators remain
# outside this account-isolation boundary.
# Set all three discovery paths to one separate directory below the config root.
# For example, provision /var/lib/post-pulsar as a traversable config root, then:
# agent_capability_file = "discovery/agent-capability"
# bootstrap_file = "discovery/bootstrap.json"
# endpoint_record_file = "discovery/endpoint.json"
# Keep operator_verifier_file in private core storage; it is never agent-readable.
allow_agent_publish = false
control_host = "127.0.0.1"
control_port = 8765
agent_capability_file = ".post-pulsar/control/agent-capability"
operator_verifier_file = ".post-pulsar/control/operator-verifier"
bootstrap_file = ".post-pulsar/control/bootstrap.json"
endpoint_record_file = ".post-pulsar/control/endpoint.json"
control_max_body_bytes = 65536
control_max_results = 100
confirmation_ttl_seconds = 300
operator_max_failures = 5
operator_lockout_seconds = 300

[[profiles]]
profile_id = "ansonphong"
account_root = "accounts/ansonphong"
timezone = "America/Vancouver"

[profiles.x]
enabled = false
expected_remote_user_id = "100000000000000001"
expected_username = "ansonphong"
token_env_var = "POST_PULSAR_X_ANSONPHONG_USER_ACCESS_TOKEN"
request_timeout_seconds = 30
processing_timeout_seconds = 300
chunk_size_bytes = 4194304

[[profiles]]
profile_id = "360hextile"
account_root = "accounts/360hextile"
timezone = "America/Vancouver"

[profiles.x]
enabled = false
expected_remote_user_id = "100000000000000002"
expected_username = "360hextile"
token_env_var = "POST_PULSAR_X_360HEXTILE_USER_ACCESS_TOKEN"
request_timeout_seconds = 30
processing_timeout_seconds = 300
chunk_size_bytes = 4194304

